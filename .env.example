# Copy this file to `.env` and adjust per environment.
# All variables exposed to the client MUST be prefixed with VITE_.

# Base URL of the backend API (used by src/core/services/httpClient.js)
VITE_API_BASE_URL=https://api.example.com

# Application display name (used by app.config.js)
VITE_APP_NAME=CRM Dashboard

# Feature flags (comma separated module ids to force-enable/disable, optional)
VITE_ENABLED_MODULES=

# Default theme mode: light | dark
VITE_DEFAULT_THEME=light
