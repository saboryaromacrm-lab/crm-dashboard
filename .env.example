# Copiá este archivo a `.env` y ajustá los valores según el entorno.
# Todas las variables que llegan al cliente DEBEN empezar con VITE_.

# URL base de la API (crm-api). La usa src/core/services/httpClient.js.
# En desarrollo, con la API corriendo localmente:
VITE_API_BASE_URL=http://localhost:3001/api

# Nombre de la aplicación (lo usa app.config.js).
VITE_APP_NAME=CRM Dashboard

# Feature flags: ids de módulos separados por coma para forzar alta/baja (opcional).
VITE_ENABLED_MODULES=

# Tema inicial: light | dark
VITE_DEFAULT_THEME=light

# Puerto del servidor de desarrollo. Vacío = 3000.
# Solo hace falta si el 3000 ya lo ocupa otra aplicación en esta máquina: la
# API valida el origen exacto, así que si Vite se corre solo a otro puerto las
# llamadas quedan bloqueadas por CORS. Acordate de sumar el mismo puerto a
# CORS_ORIGINS en el .env de crm-api.
VITE_DEV_PORT=
